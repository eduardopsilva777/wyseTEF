# Modelo do .env LOCAL (o .env real é ignorado pelo Git).
# Forma recomendada: `npm run dev:setup` — cria/completa o .env com segredos aleatórios
# e mostra uma única vez o token do painel e a chave de API.
# Nunca coloque credenciais reais de adquirentes, de produção ou de clientes aqui.

# --- Banco de desenvolvimento (docker compose em infra/dev) ---
POSTGRES_USER=tef_dev
POSTGRES_PASSWORD=defina-uma-senha-local
POSTGRES_DB=tef_dev
POSTGRES_PORT=55432

# --- API (somente loopback nesta fase) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# memory | postgres (o worker exige postgres)
TEF_PERSISTENCE=postgres
DATABASE_URL=postgres://tef_dev:defina-uma-senha-local@127.0.0.1:55432/tef_dev
# Único provedor disponível nesta fase. É recusado quando NODE_ENV=production.
TEF_PROVIDER=simulator
TEF_PROVIDER_TIMEOUT_MS=5000

# Credenciais de integração (provisório — ver docs/decisions/0009). Guarde apenas o SHA-256 da chave.
TEF_API_CREDENTIALS=[{"keyId":"dev-local","keySha256":"<sha256-hex-da-chave>","tenantId":"demo-mercado","merchantIds":["loja-centro"]}]

# Painel administrativo LOCAL (ver docs/decisions/0015). Apenas o SHA-256 do token.
# Recusado com NODE_ENV=production. Sem esta variável, as rotas /admin/api não existem.
TEF_DEV_ADMIN_TOKEN_SHA256=<sha256-hex-do-token-do-painel>
TEF_ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Worker ---
TEF_WORKER_LEASE_MS=30000
TEF_WORKER_POLL_MS=500
TEF_WORKER_BATCH=10
TEF_WORKER_HEALTH_HOST=127.0.0.1
TEF_WORKER_HEALTH_PORT=3001
# Atraso do cenário "resposta atrasada" do simulador (maior que o timeout => UNKNOWN).
TEF_SIMULATOR_DELAY_MS=8000
