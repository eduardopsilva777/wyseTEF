# Copie para .env (que é ignorado pelo Git) e preencha com valores LOCAIS de desenvolvimento.
# Nunca coloque credenciais reais de adquirentes, de produção ou de clientes neste arquivo.

# --- Banco de desenvolvimento (docker compose em infra/dev) ---
POSTGRES_USER=tef_dev
POSTGRES_PASSWORD=defina-uma-senha-local
POSTGRES_DB=tef_dev
POSTGRES_PORT=55432

# --- API ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# memory | postgres
TEF_PERSISTENCE=postgres
DATABASE_URL=postgres://tef_dev:defina-uma-senha-local@127.0.0.1:55432/tef_dev
# Único provedor disponível nesta fase. É recusado quando NODE_ENV=production.
TEF_PROVIDER=simulator
TEF_PROVIDER_TIMEOUT_MS=5000

# Credenciais de API (provisório — ver docs/decisions/0009). Guarde apenas o SHA-256 da chave.
# Gere uma chave local:  node -e "const k=require('crypto').randomBytes(32).toString('base64url');console.log(k);console.log(require('crypto').createHash('sha256').update(k).digest('hex'))"
TEF_API_CREDENTIALS=[{"keyId":"dev-local","keySha256":"<sha256-hex-da-chave>","tenantId":"tenant-dev","merchantIds":["merchant-dev"]}]
