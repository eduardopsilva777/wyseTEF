{
  "name": "tef-platform",
  "private": true,
  "type": "module",
  "description": "Plataforma de orquestração de pagamentos (TEF) — Fase 1: fundação e núcleo transacional. Nenhuma integração real com adquirentes.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/domain",
    "packages/audit",
    "packages/application",
    "packages/providers/contract",
    "packages/providers/simulator",
    "packages/persistence",
    "apps/api"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "db:up": "docker compose -f infra/dev/docker-compose.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f infra/dev/docker-compose.yml --env-file .env down",
    "db:migrate": "node packages/persistence/src/cli/migrate.ts",
    "dev:api": "node --watch apps/api/src/main.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deps": "npm audit --audit-level=moderate",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:secrets && npm run check:deps"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
